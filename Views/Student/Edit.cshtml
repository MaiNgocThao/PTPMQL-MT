@model DemoMVC1.Models.Student

<h2>Sửa thông tin sinh viên</h2>

<form asp-action="Edit" asp-route-studentCode="@Model.StudentCode" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="StudentCode" />

    <div class="form-group mb-3">
        <label asp-for="StudentCode">Mã sinh viên</label>
        <input asp-for="StudentCode" class="form-control" readonly />
    </div>

    <div class="form-group mb-3">
        <label asp-for="FullName">Họ tên</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Address">Địa chỉ</label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="FacultyId">Khoa</label>
        <select asp-for="FacultyId"
                asp-items="ViewBag.FacultyId"
                class="form-control">
            <option value="">-- Chọn khoa --</option>
        </select>
        <span asp-validation-for="FacultyId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
