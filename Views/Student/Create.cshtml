@model DemoMVC1.Models.Student

<h2>Thêm sinh viên</h2>

<form asp-action="Create" method="post">

    <div>
        <label asp-for="StudentCode">Mã sinh viên</label>
        <input asp-for="StudentCode" />

        <span asp-validation-for="StudentCode"></span>
    </div>

    <br />

    <div>
        <label asp-for="FullName">Họ tên</label>
        <input asp-for="FullName" />

        <span asp-validation-for="FullName"></span>
    </div>

    <br />

    <div>
        <label asp-for="Address">Địa chỉ</label>
        <input asp-for="Address" />

        <span asp-validation-for="Address"></span>
    </div>

    <br />

    <div>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" />

        <span asp-validation-for="Email"></span>
    </div>

    <br />

    <button type="submit">Thêm</button>

    <a asp-action="Index">Quay lại</a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}