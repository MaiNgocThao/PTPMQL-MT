@model DemoMVC1.Models.Student

<h2>Xóa sinh viên</h2>

<h3>Bạn có chắc muốn xóa sinh viên này không?</h3>

<div>

    <p>
        <strong>Mã sinh viên:</strong>
        @Model.StudentCode
    </p>

    <p>
        <strong>Họ tên:</strong>
        @Model.FullName
    </p>

    <p>
        <strong>Địa chỉ:</strong>
        @Model.Address
    </p>

    <p>
        <strong>Email:</strong>
        @Model.Email
    </p>

</div>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden"
           name="studentCode"
           value="@Model.StudentCode" />

    <button type="submit">
        Xác nhận xóa
    </button>

    <a asp-action="Index">
        Hủy
    </a>

</form>