<h1>@ViewData["Title"]</h1>
@model DemoMVC1.Models.Student

<form asp-action="Index" method="post">

```
<label>Mã sinh viên:</label>
<input type="text" name="StudentCode" placeholder="Nhập mã sinh viên" />
<br />

<label>Họ tên:</label>
<input type="text" name="FullName" placeholder="Nhập họ tên" />
<br />

<label>Địa chỉ:</label>
<input type="text" name="Address" placeholder="Nhập địa chỉ" />
<br />

<label>Email:</label>
<input type="email" name="Email" placeholder="Nhập email" />
<br />

<input type="submit" value="Gửi dữ liệu" />
```

</form>

@if (!string.IsNullOrEmpty(Model?.FullName))
{ <hr />


<h3> Thông tin sinh viên:</h3>

<p>Mã sinh viên: @Model.StudentCode</p>
<p>Họ tên: @Model.FullName</p>
<p>Địa chỉ: @Model.Address</p>
<p>Email: @Model.Email</p>
}
